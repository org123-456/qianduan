name: 不死途深夜日记定时器

on:
  schedule:
    # 国际标准时间 19:30 对应北京时间凌晨 03:30
    - cron: '30 19 * * *'
  # 允许你在 GitHub 页面上手动点一下立刻测试写日记
  workflow_dispatch:

jobs:
  write-diary:
    runs-on: ubuntu-latest
    steps:
      - name: 检出代码
        uses: actions/checkout@v3

      - name: 启动 Node 环境
        uses: actions/setup-node@v3
        with:
          node-version: 18

      - name: 安装邮件模块
        run: npm install nodemailer

      - name: 执行日记生成与邮件发送
        env:
          MAIL_USER: ${{ secrets.MAIL_USER }}
          MAIL_PASS: ${{ secrets.MAIL_PASS }}
        run: node auto_diary.js
